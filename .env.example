# ==============================================================================
# MEKDI DECOR — ENVIRONMENT CONFIGURATION TEMPLATE
# Tagline: "Making Moments Unforgettable"
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002/api

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mekdi_decor?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=mekdi_decor

# Authentication & Security
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# File Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=mekdi-decor-assets

# Ethiopian Payment Gateway Integration (Chapa & Telebirr)
DEFAULT_PAYMENT_PROVIDER=CHAPA
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=chapa_webhook_secret_here

# Notification Emails (Gmail SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password
EMAIL_FROM="Mekdi Decor Atelier" <noreply@mekdidecor.com>
